{
  "appId": "xyz.degendesk.app",
  "appName": "Degen Desk",
  "webDir": "www",
  "server": {
    "url": "https://degendesk.xyz",
    "cleartext": false,
    "allowNavigation": [
      "degendesk.xyz",
      "*.firebaseapp.com",
      "*.googleapis.com",
      "accounts.google.com"
    ]
  },
  "ios": {
    "scheme": "DegenDesk",
    "contentInset": "automatic",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "backgroundColor": "#06060b"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2500,
      "launchAutoHide": true,
      "backgroundColor": "#06060b",
      "showSpinner": false,
      "launchFadeOutDuration": 500
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#06060b"
    },
    "Keyboard": {
      "resize": "body",
      "resizeOnFullScreen": true
    }
  }
}
